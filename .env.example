# Arquivo de exemplo. Nao inclua segredos reais neste arquivo.

# Google / Sheets
GOOGLE_CREDENTIALS_PATH=deploy/credenciais.json
SPREADSHEET_URL=
SHEET_CONTAORDEM=CONTAORDEM
SHEET_CAIXAS=GERENCIAR CAIXAS
SHEET_SOMA=SOMA

# SOMA site
SITE_USER=
SITE_PASSWORD=
SITE_LOGIN_URL=https://verbodavida.info/apps/index.php
SITE_HOME_URL=https://verbodavida.info/IVV/
LOCATORS_PATH=src/soma_app/config/locators.json

# Execucao
HEADLESS=false
TIMEOUT_SECONDS=20
RETRY_COUNT=2
BATCH_SIZE=20
ALLOW_RETRY_ERROR=false
IDUSER=USERJOB
AGENDADOR_INTERVAL_SECONDS=120

# Logging / artifacts
LOG_LEVEL=INFO
CONSOLE_LOG_LEVEL=ERROR
DETAILED_RUN_LOGGING=false
RUN_ENV=dev
LOG_DIR=logs
ARTIFACTS_DIR=artifacts
SCREENSHOTS_DIR=artifacts/screenshots

# Performance tuning for pesquisa de DOC SOMA
SEARCH_DOC_ATTEMPTS=2
SEARCH_DOC_RETRY_DELAY_SECONDS=1
SEARCH_DOC_RESULT_TIMEOUT_SECONDS=8
SEARCH_DOC_BROADER_TIMEOUT_SECONDS=8
SEARCH_DOC_BACK_DOM_TIMEOUT_SECONDS=2
SEARCH_DOC_BACK_VISIBLE_TIMEOUT_SECONDS=1
SEARCH_DOC_DIRECT_DOM_TIMEOUT_SECONDS=2
SEARCH_DOC_DIRECT_VISIBLE_TIMEOUT_SECONDS=2
SEARCH_DOC_LIST_READY_TIMEOUT_SECONDS=3

# Backend mode: selenium | api
SOMA_BACKEND=selenium
RUN_CAIXAS_BANCOS=true
API_FALLBACK_SELENIUM=true

# API (somente se SOMA_BACKEND=api)
SOMA_API_BASE_URL=
SOMA_API_LOGIN=
SOMA_API_PASSWORD=
SOMA_API_TIMEOUT=40
SOMA_API_RETRIES=2
SOMA_API_BACKOFF=0.9
# token_first (default) | login_first
SOMA_API_AUTH_PREFERENCE=token_first
SOMA_SESSION_TOKEN=
SOMA_SESSION_TOKEN_CLOSE=false
